# =========================================================
# Gadget POS — Environment Variables
# Copy this file to .env and fill in the values.
# Docs: docs/configuration.md
# =========================================================

# PostgreSQL connection string (Prisma + Better Auth)
DATABASE_URL="postgresql://postgres:password@localhost:5432/gadget_pos"

# Direct connection string (only needed when using database poolers like PgBouncer for migrations)
# DIRECT_URL="postgresql://postgres:password@localhost:5432/gadget_pos"

# Better Auth secret — generate with: openssl rand -base64 48
# Must be at least 32 characters. CHANGE THIS IN PRODUCTION.
BETTER_AUTH_SECRET="change_me_generate_a_random_secret_min_32_chars"

# The canonical URL this app is accessed from (must match browser origin)
BETTER_AUTH_URL="http://localhost:3000"

# Public app URL exposed to the browser
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Comma-separated list of additional trusted origins (for production / multi-IP)
# Comma-separated additional origins. Example for LAN access:
# BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000,http://192.168.1.25:3000"

# Node environment
NODE_ENV="development"

# Set to "1" for Docker / standalone builds (enables Next.js output: standalone)
# NEXT_STANDALONE="1"
