// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Enums
// ============================================================

enum Role {
  ADMIN
  CASHIER
}

enum SaleStatus {
  COMPLETED
  VOIDED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  OTHER
}

enum ProductTrackingMode {
  QUANTITY
  SERIALIZED
}

enum ProductUnitStatus {
  AVAILABLE
  SOLD
}

enum WarrantyStatus {
  ACTIVE
  VOIDED
}

// ============================================================
// Auth models (required by Better Auth)
// ============================================================

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          Role     @default(CASHIER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sales            Sale[]
  sessions         Session[]
  accounts         Account[]
  stockAdjustments StockAdjustment[]
  refunds          Refund[]
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ============================================================
// Product
// ============================================================

model Product {
  id                String              @id @default(cuid())
  name              String
  sku               String?             @unique
  barcode           String?             @unique
  price             Decimal             @db.Decimal(10, 2)
  cost              Decimal?            @db.Decimal(10, 2)
  stock             Int                 @default(0)
  category          String?
  imageUrl          String?
  lowStockThreshold Int                 @default(5)
  trackingMode      ProductTrackingMode @default(QUANTITY)
  warrantyMonths    Int                 @default(0)
  active            Boolean             @default(true)
  supplierId        String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  saleItems        SaleItem[]
  stockAdjustments StockAdjustment[]
  units            ProductUnit[]
  supplier         Supplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)
}

model ProductUnit {
  id           String            @id @default(cuid())
  productId    String
  serialNumber String?           @unique
  imei         String?           @unique
  status       ProductUnitStatus @default(AVAILABLE)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  saleItem SaleItem?

  @@index([productId, status])
}

// ============================================================
// Customer
// ============================================================

model Customer {
  id            String   @id @default(cuid())
  name          String
  phone         String?  @unique
  email         String?  @unique
  notes         String?
  loyaltyPoints Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sales       Sale[]
  loyaltyLogs LoyaltyLog[]
}

// ============================================================
// Sales
// ============================================================

model Sale {
  id             String        @id @default(cuid())
  userId         String
  customerId     String?
  subtotal       Decimal       @db.Decimal(10, 2)
  taxRate        Decimal       @default(0) @db.Decimal(5, 2)
  taxAmount      Decimal       @db.Decimal(10, 2)
  discountAmount Decimal       @default(0) @db.Decimal(10, 2)
  tipAmount      Decimal?      @db.Decimal(10, 2)
  total          Decimal       @db.Decimal(10, 2)
  paymentMethod  PaymentMethod @default(CASH)
  paymentLines   Json?
  amountTendered Decimal?      @db.Decimal(10, 2)
  changeDue      Decimal?      @db.Decimal(10, 2)
  status         SaleStatus    @default(COMPLETED)
  voidReason     String?
  notes          String?
  createdAt      DateTime      @default(now())

  user        User         @relation(fields: [userId], references: [id])
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items       SaleItem[]
  refunds     Refund[]
  loyaltyLogs LoyaltyLog[]
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  productId String?
  unitId    String? @unique
  name      String
  price     Decimal @db.Decimal(10, 2)
  quantity  Int
  total     Decimal @db.Decimal(10, 2)
  notes     String?

  sale     Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product  Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  unit     ProductUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)
  warranty Warranty?
}

model Warranty {
  id         String         @id @default(cuid())
  saleItemId String         @unique
  startsAt   DateTime
  expiresAt  DateTime
  status     WarrantyStatus @default(ACTIVE)
  createdAt  DateTime       @default(now())

  saleItem SaleItem @relation(fields: [saleItemId], references: [id], onDelete: Cascade)

  @@index([status, expiresAt])
}

// ============================================================
// Held Orders (POS "Park Sale" feature)
// ============================================================

model HeldOrder {
  id           String   @id @default(cuid())
  label        String?
  cartSnapshot Json
  createdAt    DateTime @default(now())
}

// ============================================================
// Loyalty
// ============================================================

enum LoyaltyLogType {
  EARN
  REDEEM
  ADJUST
}

model LoyaltyLog {
  id         String         @id @default(cuid())
  customerId String
  saleId     String?
  delta      Int
  type       LoyaltyLogType
  note       String?
  createdAt  DateTime       @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sale     Sale?    @relation(fields: [saleId], references: [id], onDelete: SetNull)
}

// ============================================================
// Inventory
// ============================================================

enum StockAdjReason {
  RECEIVED
  DAMAGED
  THEFT
  CORRECTION
  OPENING_COUNT
}

model StockAdjustment {
  id        String         @id @default(cuid())
  productId String
  userId    String
  delta     Int
  reason    StockAdjReason
  note      String?
  createdAt DateTime       @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])
}

model Supplier {
  id          String   @id @default(cuid())
  name        String
  contactName String?
  phone       String?
  email       String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
}

// ============================================================
// Refunds
// ============================================================

model Refund {
  id           String   @id @default(cuid())
  saleId       String
  userId       String
  amount       Decimal  @db.Decimal(10, 2)
  reason       String?
  items        Json
  restoreStock Boolean  @default(true)
  createdAt    DateTime @default(now())

  sale Sale @relation(fields: [saleId], references: [id])
  user User @relation(fields: [userId], references: [id])
}

// ============================================================
// Business Settings (single-row singleton)
// ============================================================

model BusinessSettings {
  id                 String   @id @default("singleton")
  name               String   @default("My Store")
  logoUrl            String?
  primaryColor       String   @default("#0f2044")
  accentColor        String   @default("#f5c518")
  currency           String   @default("K")
  currencyDecimals   Int      @default(2)
  taxRate            Decimal  @default(0) @db.Decimal(5, 4)
  taxName            String   @default("Tax")
  receiptFooter      String   @default("Thank you for your purchase!")
  // Loyalty
  loyaltyEnabled     Boolean  @default(false)
  loyaltyEarnRate    Decimal  @default(1) @db.Decimal(8, 4) // points per $1 spent
  loyaltyRedeemValue Decimal  @default(100) @db.Decimal(8, 4) // points per $1 discount
  // Low-stock
  lowStockThreshold  Int      @default(5)
  setupComplete      Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}
